use v6.d;
use lib 'lib';
use Test;
use BDD::Behave::LoadProgress;

plan 11;

{
  my $progress = LoadProgress.new(:total(2));
  $progress.feed("{LOAD-PROGRESS-MARKER}specs/a-spec.raku\n{LOAD-PROGRESS-MARKER}specs/");
  $progress.feed("b-spec.raku\n");

  is-deeply $progress.loaded.List, ('specs/a-spec.raku', 'specs/b-spec.raku'),
    'a marker split across chunks records both spec files in load order';
}

{
  my $progress = LoadProgress.new(:total(1));
  $progress.feed("{LOAD-PROGRESS-MARKER}specs/a-spec.raku\nwarning: deprecated\npartial");
  $progress.finish;

  is $progress.other-text, "warning: deprecated\npartial\n",
    'other stderr lines are kept, including an unterminated last line';
  is-deeply $progress.loaded.List, ('specs/a-spec.raku',),
    'other stderr lines are left out of the loaded spec files';
}

{
  my @pieces;
  my @ticks = 1, 1.5, 1.5, 3;

  my $progress = LoadProgress.new(
    :total(3),
    :output(-> $text, :$partial { @pieces.push: $partial ?? $text !! $text ~ "\n" }),
    :clock({ @ticks.shift }),
  );
  $progress.feed("{LOAD-PROGRESS-MARKER}specs/a-spec.raku\n{LOAD-PROGRESS-MARKER}specs/b-spec.raku\n");
  $progress.finish;

  is @pieces.join, "  [1/3] specs/a-spec.raku (0.5s)\n  [2/3] specs/b-spec.raku (1.5s)\n",
    'an output callable gets a numbered line for each spec file with the seconds it took to load';
}

is LoadProgress.new.stall-description, 'before loading any spec file',
  'a stall before any marker says no spec file had started';

is LoadProgress.new(:noun<module>).stall-description, 'before loading any module',
  'a stall before any marker names the kind of thing being loaded';

{
  my $progress = LoadProgress.new;
  $progress.feed("{LOAD-PROGRESS-MARKER}specs/a-spec.raku\n");

  is $progress.stall-description, 'while loading specs/a-spec.raku',
    'a stall after one marker names that spec file';
}

{
  my $progress = LoadProgress.new;
  $progress.feed("{LOAD-PROGRESS-MARKER}specs/a-spec.raku\n{LOAD-PROGRESS-MARKER}specs/b-spec.raku\n");

  is $progress.stall-description, 'while loading specs/b-spec.raku (loaded after specs/a-spec.raku)',
    'a stall after two markers names the loading spec file and the one before it';
}

my class CapturedStderr {
  has Str $.text = '';

  method print($text) { $!text ~= $text }
  method say($text) { $!text ~= "$text\n" }
  method flush() { }
}

sub stderr-from(&write --> Str) {
  my $*ERR = CapturedStderr.new;
  write();
  $*ERR.text;
}

is stderr-from({ note-progress('  [1/2] specs/a-spec.raku', :partial) }), '  [1/2] specs/a-spec.raku',
  'note-progress leaves a partial line open for the rest of it';
is stderr-from({ note-progress(' (0.5s)') }), " (0.5s)\n",
  'note-progress ends a whole line with a newline';

is elapsed-text(2.46), ' (2.5s)', 'elapsed-text rounds the seconds to one decimal place';

done-testing;

use v6.d;
use lib 'lib';
use Test;

use BDD::Behave::Configuration;

plan 9;

sub make-fixture-dir(--> IO::Path) {
  my $dir = $*TMPDIR.add("behave-parallel-mode-t-{$*PID}-{(now * 1e6).Int}");
  $dir.mkdir;
  $dir;
}

sub pid-spec(Str $group --> Str) {
  my $template = q:to/END/;
  use BDD::Behave;

  describe 'GROUP', {
    it 'records the process it ran in', {
      %*ENV<BEHAVE_PROBE_DIR>.IO.add('GROUP').spurt($*PID.Str);
      expect(1).to.be(1);
    }
  }
  END
  $template.subst('GROUP', $group, :g);
}

sub slot-spec(Str $group --> Str) {
  my $template = q:to/END/;
  use BDD::Behave;

  describe 'GROUP', {
    it 'records the worker slot it ran in', {
      %*ENV<BEHAVE_PROBE_DIR>.IO.add('GROUP')
        .spurt(%*ENV<BEHAVE_WORKER_INDEX> // 'none');
      expect(1).to.be(1);
    }
  }
  END
  $template.subst('GROUP', $group, :g);
}

sub run-behave(IO::Path $probe-dir, @argv --> Nil) {
  my %env = |%*ENV;
  %env<BEHAVE_DISABLE_CONFIG> = '1';
  %env<BEHAVE_PROBE_DIR> = $probe-dir.absolute;
  %env<BEHAVE_WORKER_INDEX>:delete;
  %env<BEHAVE_WORKER_COUNT>:delete;

  my $proc = run(
    'raku', '-Ilib', 'bin/behave', '--no-config', '--format', 'progress', |@argv,
    :out, :err, :cwd($*CWD), :%env,
  );
  $proc.out.slurp(:close);
  $proc.err.slurp(:close);
}

sub remove-dir(IO::Path $dir --> Nil) {
  return unless $dir.e;
  for $dir.dir -> $entry { $entry.unlink if $entry.f }
  $dir.rmdir;
}

is BDD::Behave::Configuration::resolve-parallel-mode(Str), 'isolated',
  'an unset mode resolves to isolated';

is BDD::Behave::Configuration::resolve-parallel-mode('queue'), 'queue',
  'an explicitly requested mode is kept';

is BDD::Behave::Configuration::resolve-parallel-mode('LPT'), 'lpt',
  'a requested mode is lower-cased';

is BDD::Behave::Configuration::DEFAULT-PARALLEL-MODE, 'isolated',
  'isolated is named as the default mode';

is BDD::Behave::Configuration::defaults().parallel-mode, 'isolated',
  'a fresh configuration carries the default mode';

is BDD::Behave::Configuration::PARALLEL-MODES.grep({
     BDD::Behave::Configuration::is-parallel-mode($_)
   }).elems, 3,
  'every documented mode is accepted';

nok BDD::Behave::Configuration::is-parallel-mode('threads'),
  'an unknown mode is rejected';

{
  my $workspace = make-fixture-dir;
  my $probe-dir = $workspace.add('probes');
  my $spec-dir  = $workspace.add('specs');
  $probe-dir.mkdir;
  $spec-dir.mkdir;

  $spec-dir.add('first-spec.raku').spurt(pid-spec('first'));
  $spec-dir.add('second-spec.raku').spurt(pid-spec('second'));

  run-behave($probe-dir, [$spec-dir.absolute]);

  my @pids = $probe-dir.dir.grep(*.f).map(*.slurp).unique;

  is @pids.elems, 2, 'the default mode runs each spec file in its own process';

  remove-dir($probe-dir);
  remove-dir($spec-dir);
  remove-dir($workspace);
}

{
  my $workspace = make-fixture-dir;
  my $probe-dir = $workspace.add('probes');
  my $spec-dir  = $workspace.add('specs');
  $probe-dir.mkdir;
  $spec-dir.mkdir;

  for <alpha beta gamma delta> -> $name {
    $spec-dir.add($name ~ '-spec.raku').spurt(slot-spec($name));
  }

  run-behave($probe-dir, ['--parallel', '2', $spec-dir.absolute]);

  my @slots = $probe-dir.dir.grep(*.f).map(*.slurp);

  is @slots.grep({ $_ eq '0' | '1' }).elems, 4,
    'every worker slot stays inside the requested worker count';

  remove-dir($probe-dir);
  remove-dir($spec-dir);
  remove-dir($workspace);
}

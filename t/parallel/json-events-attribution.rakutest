use v6.d;
use lib 'lib';
use Test;
use BDD::Behave::Parallel::EventStream;

plan 8;

my $root    = $*PROGRAM.parent.parent.parent;
my $lib     = $root.add('lib');
my $bin     = $root.add('bin/behave');
my $failing = $root.add('t/fixtures/failing-fixture-spec.raku');

sub run-behave(*@args) {
  my %env = |%*ENV;
  %env<BEHAVE_DISABLE_CONFIG> = '1';
  my $proc = Proc::Async.new(
    'raku', "-I{$lib.absolute}", $bin.absolute, |@args, :w,
  );
  my $out = '';
  $proc.stdout.tap(-> $c { $out ~= $c });
  $proc.stderr.tap(-> $c { });
  my $done = $proc.start(:%env);
  $proc.close-stdin;
  my $completed = await $done;
  $out;
}

sub failure-by-example(*@extra-args --> Hash) {
  my $out = run-behave('--format', 'json-events', '--order', 'defined', |@extra-args, $failing.absolute);

  my %by-description;
  for $out.lines -> $line {
    next unless $line.trim.starts-with('{');
    my %event = parse-json-event($line);
    next unless (%event<type> // '') eq 'example-fail';
    my @failures = (%event<failures> // ()).list;
    %by-description{%event<description>} = @failures ?? @failures[0] !! %();
  }

  %by-description;
}

# The fixture's three examples fail on distinct lines, so the reported line is
# what ties a failure back to the example that produced it.
my %in-process = failure-by-example();

is %in-process{'first example fails'}<line>, 5,
  'no workers: first failing example carries its own failure line';
is %in-process{'second example fails'}<line>, 9,
  'no workers: second failing example carries its own failure line';
is %in-process{'third example fails'}<line>, 13,
  'no workers: third failing example carries its own failure line';
is %in-process{'first example fails'}<expected>, '2',
  'no workers: compared values land in the expected and given fields';

my %parallel = failure-by-example('--parallel', '2');

is %parallel{'first example fails'}<line>, 5,
  'parallel: first failing example carries its own failure line';
is %parallel{'second example fails'}<line>, 9,
  'parallel: second failing example carries its own failure line';
is %parallel{'third example fails'}<line>, 13,
  'parallel: third failing example carries its own failure line';
ok %parallel{'first example fails'}<message>.contains('to be: 2'),
  'parallel: compared values land in the message field instead';

use v6.d;
use lib 'lib';
use Test;
use BDD::Behave::Parallel::EventStream;

plan 14;

my $root    = $*PROGRAM.parent.parent.parent;
my $lib     = $root.add('lib');
my $bin     = $root.add('bin/behave');
my $failing = $root.add('t/fixtures/failing-fixture-spec.raku');

sub run-behave(*@args) {
  my %env = |%*ENV;
  %env<BEHAVE_DISABLE_CONFIG> = '1';
  my $proc = Proc::Async.new(
    'raku', "-I{$lib.absolute}", $bin.absolute, |@args, :w,
  );
  my $out = '';
  $proc.stdout.tap(-> $c { $out ~= $c });
  $proc.stderr.tap(-> $c { });
  my $done = $proc.start(:%env);
  $proc.close-stdin;
  my $completed = await $done;
  $out;
}

sub failure-by-example(*@extra-args --> Hash) {
  my $out = run-behave('--format', 'json-events', '--order', 'defined', |@extra-args, $failing.absolute);

  my %by-description;
  for $out.lines -> $line {
    next unless $line.trim.starts-with('{');
    my %event = parse-json-event($line);
    next unless (%event<type> // '') eq 'example-fail';
    my @failures = (%event<failures> // ()).list;
    %by-description{%event<description>} = @failures ?? @failures[0] !! %();
  }

  %by-description;
}

# The fixture's three examples fail on distinct lines, so the reported line is
# what ties a failure back to the example that produced it. Both paths report
# the same record for the same failure.
for (
  ('no workers', failure-by-example()),
  ('parallel',   failure-by-example('--parallel', '2')),
) -> ($path, %failure) {
  is %failure{'first example fails'}<line>, 5,
    "$path: first failing example carries its own failure line";
  is %failure{'second example fails'}<line>, 9,
    "$path: second failing example carries its own failure line";
  is %failure{'third example fails'}<line>, 13,
    "$path: third failing example carries its own failure line";
  is %failure{'first example fails'}<given>, '1',
    "$path: the value the example was given";
  is %failure{'first example fails'}<expected>, '2',
    "$path: the value the example expected";
  is %failure{'first example fails'}<message>, "Expected: 1\nto be: 2",
    "$path: the comparison rendered as a message";
  nok %failure{'first example fails'}<negated>,
    "$path: the expectation was not negated";
}

done-testing;

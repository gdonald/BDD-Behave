use v6.d;
use lib 'lib';
use Test;

use BDD::Behave::Parallel::EventStream;

plan 50;

is parse-json-event('{"a":"say \"hi\""}')<a>, 'say "hi"',
  'scan: escaped quote';
is parse-json-event('{"a":"C:\\\\path"}')<a>, 'C:\\path',
  'scan: escaped backslash';
is parse-json-event('{"a":"\/root"}')<a>, '/root',
  'scan: escaped forward slash';
is parse-json-event('{"a":"x\ry\bz\fw"}')<a>, "x\ry\bz\fw",
  'scan: carriage return, backspace, and form feed escapes';
is parse-json-event('{"a":"caf\u00e9"}')<a>, 'café',
  'scan: unicode escape';
is parse-json-event('{"a":"plain text"}')<a>, 'plain text',
  'scan: a string with no escapes';
is parse-json-event('{"a":""}')<a>, '',
  'scan: empty string value';
is parse-json-event('{}').elems, 0,
  'scan: empty object';
is parse-json-event('{"a":[]}')<a>.elems, 0,
  'scan: empty array';
is parse-json-event('{"a":[1,2,3]}')<a>[2], 3,
  'scan: array of scalars';
is parse-json-event(qq[\{ "a" : \{ "b" : [ 1 , 2 ] \} \}])<a><b>[1], 2,
  'scan: whitespace between tokens';
is parse-json-event('{"a":-42}')<a>, -42,
  'scan: negative integer';
is parse-json-event('{"a":1.5e2}')<a>, 150e0,
  'scan: lower-case exponent';
is parse-json-event('{"a":2E+3}')<a>, 2000e0,
  'scan: upper-case exponent with a sign';
is parse-json-event('{"a":5e-1}')<a>, 0.5e0,
  'scan: negative exponent';

# The scanner walks codepoints, so a multi-byte character before an escape
# would misplace every later position if the two ever disagreed.
is parse-json-event('{"a":"héllo\tworld","b":7}')<b>, 7,
  'scan: keeps its place across text outside the ASCII range';
is parse-json-event('{"a":"héllo\tworld"}')<a>, "héllo\tworld",
  'scan: text after a multi-byte character is unchanged';

dies-ok { parse-json-event('{"a":"\q"}') }, 'scan: unknown escape';
dies-ok { parse-json-event('{"a":"open') }, 'scan: unterminated string';
dies-ok { parse-json-event('{"a":?}') },    'scan: character that starts no value';
dies-ok { parse-json-event('{a:1}') },      'scan: object key that is not a string';
dies-ok { parse-json-event('{"a" 1}') },    'scan: missing colon after a key';
dies-ok { parse-json-event('{"a":1 "b":2}') }, 'scan: missing separator between members';
dies-ok { parse-json-event('{"a":[1 2]}') }, 'scan: missing separator between elements';
dies-ok { parse-json-event('{"a":tru}') },  'scan: truncated literal';
dies-ok { parse-json-event('') },           'scan: empty document';

{
  my $parser = BDD::Behave::Parallel::EventStream::JsonLineParser.new;
  my $chunk  = (^50).map({ qq[\{"type":"example-pass","id":"a:$_"\}] }).join("\n") ~ "\n";
  my @events = $parser.feed($chunk);

  is @events.elems, 50, 'feed: a many-line chunk yields one event per line';
  is @events[49]<id>, 'a:49', 'feed: a many-line chunk keeps its order';
}

{
  my $parser = BDD::Behave::Parallel::EventStream::JsonLineParser.new;
  $parser.feed(qq[\{"id":"a:1"\}\n\{"id":"a:2"\}\n\{"id":"a:3"\}]);

  is $parser.flush()[0]<id>, 'a:3', 'feed: the trailing partial line is held back';
}

{
  my $parser = BDD::Behave::Parallel::EventStream::JsonLineParser.new;

  is $parser.feed(qq[\{"id":"a:1"\}\n\n   \n\{"id":"a:2"\}\n]).elems, 2,
    'feed: blank lines inside a chunk are skipped';
}

# Parse simple object
{
  my %ev = parse-json-event('{"type":"example-pass","id":"x:1","duration":0.5}');
  is %ev<type>,     'example-pass', 'parse: type field';
  is %ev<id>,       'x:1',          'parse: id field';
  is %ev<duration>, 0.5,            'parse: number field as Real';
}

# Parse with booleans and null
{
  my %ev = parse-json-event('{"a":true,"b":false,"c":null}');
  is %ev<a>, True,  'parse: true';
  is %ev<b>, False, 'parse: false';
  nok %ev<c>.defined, 'parse: null becomes Nil';
}

# Parse arrays and nested
{
  my %ev = parse-json-event('{"failures":[{"line":42},{"line":7}]}');
  is %ev<failures>.elems, 2, 'parse: nested array';
  is %ev<failures>[0]<line>, 42, 'parse: nested object';
}

# Strings with escapes
{
  my %ev = parse-json-event('{"msg":"line1\nline2","tab":"a\tb","quote":"he said \"hi\""}');
  is %ev<msg>,   "line1\nline2", 'parse: \\n escape';
  is %ev<tab>,   "a\tb",         'parse: \\t escape';
  is %ev<quote>, 'he said "hi"', 'parse: \\" escape';
}

# JsonLineParser feed buffers partial lines
{
  my $parser = BDD::Behave::Parallel::EventStream::JsonLineParser.new;
  my @ev1 = $parser.feed('{"type":"example-pass","id":"a:1"}');
  is @ev1.elems, 0, 'feed without newline buffers';
  my @ev2 = $parser.feed("\n");
  is @ev2.elems, 1, 'feed with newline flushes one event';
  is @ev2[0]<id>, 'a:1', 'buffered + newline yields full event';
}

# Multi-event feed
{
  my $parser = BDD::Behave::Parallel::EventStream::JsonLineParser.new;
  my $chunk = '{"type":"example-pass","id":"a:1"}' ~ "\n"
            ~ '{"type":"example-pass","id":"a:2"}' ~ "\n";
  my @ev = $parser.feed($chunk);
  is @ev.elems, 2, 'multi-line feed yields multiple events';
}

# Parse-error event for malformed JSON
{
  my $parser = BDD::Behave::Parallel::EventStream::JsonLineParser.new;
  my @ev = $parser.feed("this is not json\n");
  is @ev[0]<type>, 'parse-error', 'malformed input emits parse-error';
}

# A stray line that parses as a bare JSON number is not a valid event
{
  my $parser = BDD::Behave::Parallel::EventStream::JsonLineParser.new;
  my @ev = $parser.feed("2026-07-05T02:40:57 info: DELETE FROM posts\n");
  is @ev[0]<type>, 'parse-error', 'bare-number-prefixed stray line emits parse-error';
}

{
  my $parser = BDD::Behave::Parallel::EventStream::JsonLineParser.new;
  my @ev = $parser.feed("42\n");
  is @ev[0]<type>, 'parse-error', 'bare JSON scalar emits parse-error';
}

# flush emits the buffered event when no trailing newline arrived
{
  my $parser = BDD::Behave::Parallel::EventStream::JsonLineParser.new;
  $parser.feed('{"type":"example-pass","id":"a:1"}');

  my @ev = $parser.flush;
  is @ev.elems, 1, 'flush yields the buffered event';
  is @ev[0]<id>, 'a:1', 'flushed buffer yields full event';
}

# flush treats a buffered non-object value as a parse-error
{
  my $parser = BDD::Behave::Parallel::EventStream::JsonLineParser.new;
  $parser.feed('42');

  my @ev = $parser.flush;
  is @ev[0]<type>, 'parse-error', 'flushed bare JSON scalar emits parse-error';
}

done-testing;

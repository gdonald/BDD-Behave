use v6.d;
use lib 'lib';
use Test;

use BDD::Behave::Bisect;

plan 4;

# Driving the bisector directly, rather than through bin/behave, reads back the
# record it keeps of its own work.
my $fixture = $*PROGRAM.parent.parent.parent.add('t/fixtures/bisect-fixture-spec.raku');

my $bisector = BDD::Behave::Bisect::Bisector.new(
  :spec-files([$fixture.absolute]),
  :quiet,
);

my $result = $bisector.run;

ok $result.had-failures, 'the initial pass found failures';
ok $result.initial-failing[0].ends-with(':29'), 'the failing example is named';
ok $result.minimal-deps{$result.initial-failing[0]}[0].ends-with(':20'),
  'the minimal prior set is kept';
ok $bisector.iterations > 1, 'the subprocess runs it took are counted';

done-testing;

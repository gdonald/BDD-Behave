use v6.d;
use lib 'lib';
use Test;

use BDD::Behave;
use BDD::Behave::SpecRegistry;
use BDD::Behave::LetRuntime;

plan 19;

registry().clear;

my $outer-called = 0;
my $inner-called = 0;

describe 'outer', {
  let(:foo, { ++$outer-called; 1 });

  context 'inner', {
    let(:foo, { ++$inner-called; 2 });

    it 'collects lets', {
      pass 'registered';
    }
  }
}

my $example = suites()[0].groups[0].groups[0].examples[0];
my @lets = $example.get-metadata('lets').flat;
is @lets.elems, 2, 'captures lets from ancestors';
is @lets[0].name, 'foo', 'stores let name';

my $runtime = BDD::Behave::LetRuntime::LetRuntime.new(:definitions(@lets));
is $runtime.value('foo'), 2, 'nearest let wins';
is $runtime.value('foo'), 2, 'memoizes per example';
is $inner-called, 1, 'evaluates inner let once';
is $outer-called, 0, 'does not execute shadowed parent let';

ok $runtime.has-name('foo'), 'has-name finds a defined let';
ok $runtime.has-name(':foo'), 'has-name ignores a leading colon on the query';
nok $runtime.has-name('bar'), 'has-name returns False for an undefined name';

sub runtime-of(*@definitions) {
  BDD::Behave::LetRuntime::LetRuntime.new(:definitions(@definitions));
}

{
  my $colonized = runtime-of(LetDefinition.new(:name(':colonized'), :block({ 'yes' })));

  ok $colonized.has-name('colonized'),
    'a name declared with a colon is found by its bare spelling';
  is $colonized.value('colonized'), 'yes',
    'a name declared with a colon reads by its bare spelling';
  is $colonized.value(':colonized'), 'yes',
    'a name declared with a colon reads by its colon spelling';
}

{
  my $shadowed = runtime-of(
    LetDefinition.new(:name<shadowed>, :block({ 'outer' })),
    LetDefinition.new(:name<shadowed>, :block({ 'inner' })),
  );

  is $shadowed.value('shadowed'), 'inner', 'the last definition of a name wins';
}

{
  my $mixed = runtime-of(
    LetDefinition.new(:name<mixed>, :block({ 'outer' })),
    LetDefinition.new(:name(':mixed'), :block({ 'inner' })),
  );

  is $mixed.value('mixed'), 'inner', 'the two spellings of a name are one name';
}

{
  my $late = runtime-of();
  $late.add-definition(LetDefinition.new(:name<added>, :block({ 'late' })));

  ok $late.has-name('added'), 'a definition added later is found';
  is $late.value('added'), 'late', 'a definition added later reads its value';
}

dies-ok { runtime-of().value('missing') }, 'reading a name that was never defined dies';


{
  my $named = runtime-of(
    LetDefinition.new(:name<beta>, :block({ 1 })),
    LetDefinition.new(:name<alpha>, :block({ 2 })),
    LetDefinition.new(:name<beta>, :block({ 3 })),
  );

  is $named.names.elems, 2, 'each definition is named once';
  is $named.names.join(','), 'beta,alpha', 'the order they were declared in is kept';
}

done-testing;

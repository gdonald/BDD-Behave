use v6.d;
use lib 'lib';
use Test;
use Test::Output;

use BDD::Behave::Formatter::HTML;
use BDD::Behave::Runner;
use BDD::Behave::SpecTree;

plan 12;

constant Suite        = BDD::Behave::SpecTree::Suite;
constant ExampleGroup = BDD::Behave::SpecTree::ExampleGroup;
constant Example      = BDD::Behave::SpecTree::Example;
constant RunResult    = BDD::Behave::Runner::RunResult;

# The formatter collects fragments and writes one page at the end of the run,
# so each block below drives a small run and reads the page back.
sub page-of(&drive, Bool :$multi-file = False --> Str) {
  my $formatter = BDD::Behave::Formatter::HTML.new;
  my $suite = Suite.new(:description('spec.raku'), :file('/abs/spec.raku'.IO), :line(1));

  stdout-from({
    $formatter.suite-loading(:file('/abs/spec.raku'));
    $formatter.suite-start($suite, :$multi-file);
    drive($formatter, $suite);
    $formatter.suite-end($suite);
    $formatter.run-summary(RunResult.new, :order('defined'));
    $formatter.multi-file-overall(RunResult.new, :order('defined')) if $multi-file;
  });
}

sub example-in($suite --> Example) {
  my $ex = Example.new(
    :description('an example'), :file('/abs/spec.raku'.IO), :line(7), :block(sub { }),
  );
  $suite.add-child($ex);
  $ex;
}

ok page-of(-> $formatter, $suite { }).contains('.example.pass'),
  'the page carries the stylesheet';
ok page-of(-> $formatter, $suite { }, :multi-file).contains('spec.raku</h2>'),
  'a run spanning several files names each one';

{
  my $formatter = BDD::Behave::Formatter::HTML.new;
  my $suite = Suite.new(:description('spec.raku'), :file('/abs/spec.raku'.IO), :line(1));

  is stdout-from({
    $formatter.suite-start($suite, :multi-file);
    $formatter.run-summary(RunResult.new, :order('defined'));
  }), '', 'one file of a run spanning several writes nothing';
}

{
  my $page = page-of(-> $formatter, $suite {
    my $group = ExampleGroup.new(
      :description('a group'), :file('/abs/spec.raku'.IO), :line(5),
    );
    $suite.add-child($group);

    $formatter.group-start($group);
    $formatter.group-around-skipped($group);
    $formatter.group-end($group);
  });

  ok $page.contains('class="example skipped"'), 'a skipped group is marked as skipped';
  ok $page.contains('around-all did not invoke continuation'), 'a skipped group says why';
}

ok page-of(-> $formatter, $suite {
  $formatter.example-around-skipped(example-in($suite));
}).contains('around-each did not invoke continuation'), 'a skipped example says why';

ok page-of(-> $formatter, $suite {
  $formatter.example-skipped(example-in($suite));
}).contains('skipped'), 'a plain skip is marked';

{
  my $formatter = BDD::Behave::Formatter::HTML.new;
  my $suite = Suite.new(:description('spec.raku'), :file('/abs/spec.raku'.IO), :line(1));

  is stdout-from({ $formatter.example-slow(example-in($suite), :threshold(0.1)) }), '',
    'a slow example writes nothing';
  is stdout-from({ $formatter.profile-summary([], :limit(5)) }), '',
    'no profile section is written';
  is stdout-from({ $formatter.multi-file-profile(Nil, [], :limit(5)) }), '',
    'no profile section is written for a run spanning several files';
  is stdout-from({ $formatter.benchmark-summary-section([], []) }), '',
    'no benchmark section is written';
  is stdout-from({ $formatter.multi-file-benchmark(Nil, [], []) }), '',
    'no benchmark section is written for a run spanning several files';
}

done-testing;

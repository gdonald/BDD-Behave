use v6.d;
use lib 'lib';
use Test;

use BDD::Behave;

plan 16;

my class Mailer {
  method deliver($message) { $message }
  method address { 'nowhere' }
}

is double(Mailer).double-name, 'Mailer', 'a double takes the short name of its class';
is double(Mailer, :address('here')).address, 'here', 'a double answers a method the class has';

throws-like { double(Mailer, :missing('x')) }, Exception,
  message => /"cannot stub 'missing'"/, 'a stub for a missing method is refused';
throws-like { double(Mailer, :missing('x')) }, Exception,
  message => /'Mailer has no such method'/, 'the class is named in the refusal';
throws-like { double(Mailer).add-stub(:missing('x')) }, Exception,
  message => /"cannot stub 'missing'"/, 'a stub added later for a missing method is refused';
throws-like { double(Mailer).missing }, Exception,
  message => /"has no method 'missing'"/, 'a call to a missing method is refused';

is double(Mailer).add-stub(:address('later')).address, 'later',
  'a stub added later for a real method answers';

is double('Logger').double-name, 'Logger', 'a double takes the name it was given';
is double().double-name, 'anonymous', 'a double with no name is anonymous';
is double('Logger', :level('warn')).level, 'warn', 'a double answers what it was stubbed with';

throws-like { double('Logger', Mailer) }, Exception,
  message => /'takes at most one positional argument'/,
  'more than one positional argument is refused';

{
  my $log = double('Logger', :info(Nil));
  $log.info('first');
  $log.info('second');

  is $log.call-count('info'), 2, 'calls to a method are counted';
  ok $log.received('info'), 'a received method is reported';
  nok $log.received('warn'), 'a method never sent is not reported';

  $log.reset;
  is $log.calls.elems, 0, 'a reset forgets the calls';
  ok $log.stubs<info>:exists, 'a reset keeps the stubs';
}

done-testing;

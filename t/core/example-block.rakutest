use v6.d;
use lib 'lib';
use Test;

use BDD::Behave::SpecTree;
use BDD::Behave::LetRuntime;

plan 6;

constant Example = BDD::Behave::SpecTree::Example;

# An example run outside a runner has no let runtime in scope, which is the
# branch where it builds one from the lets it carries.
sub execute-without-runtime($example) {
  my $*LET-RUNTIME = Nil;
  $example.execute;
}

{
  my @seen;
  my $example = Example.new(
    :description('takes a context'),
    :file('specs/example.raku'),
    :line(1),
    :block(-> $context { @seen.push($context.defined) }),
  );

  $example.execute;
  ok @seen[0], 'a block taking a positional argument is handed a context';

  $example.execute for ^2;
  is @seen.elems, 3, 'the context is handed over on every run';
}

{
  my @runs;
  my $example = Example.new(
    :description('takes nothing'),
    :file('specs/example.raku'),
    :line(2),
    :block(sub { @runs.push(1) }),
  );

  $example.execute;
  is @runs.elems, 1, 'a block taking no argument runs';

  $example.execute for ^2;
  is @runs.elems, 3, 'a block taking no argument runs again on a repeat';
}

{
  my @values;
  my $example = Example.new(
    :description('takes a named argument'),
    :file('specs/example.raku'),
    :line(3),
    :block(-> :$value { @values.push($value) }),
  );

  $example.execute(:value(7));
  is @values[0], 7, 'a block taking only named arguments is given them, not a context';
}


{
  my @seen;
  my $example = Example.new(
    :description('reads a let'),
    :file('specs/example.raku'),
    :line(4),
    :block(-> $context { @seen.push($*LET-RUNTIME.value('a-value')) }),
  );
  $example.set-metadata(:lets([
    LetDefinition.new(:name('a-value'), :block({ 'from the let' })),
  ]));

  execute-without-runtime($example);

  is @seen[0], 'from the let', 'an example with no runtime in scope builds one from its lets';
}

done-testing;
